# 复制本文件为 .env，填入你自己的 DeepSeek API Key
DEEPSEEK_API_KEY=sk-your-key-here

# 可选配置
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
MAX_STEPS=8

# 单轮上下文压缩：scratchpad 超过该字符数后，较早步骤会交给模型摘要
CONTEXT_COMPACT_CHARS=7000
CONTEXT_KEEP_CHARS=2400
CONTEXT_SUMMARY_MAX_CHARS=1200

# 跨轮会话历史压缩：超过消息数/字符数后，较早对话会被增量摘要并保存到会话文件
HISTORY_COMPACT_CHARS=9000
HISTORY_COMPACT_MESSAGES=12
HISTORY_KEEP_MESSAGES=8
HISTORY_SUMMARY_BATCH_MESSAGES=4

# 本地向量记忆索引（SQLite + 特征哈希，无需额外 API Key）
# 设为 false 可做“纯关键词 vs 向量混合检索”的消融实验
VECTOR_MEMORY_ENABLED=true
VECTOR_DIM=512
VECTOR_SEARCH_LIMIT=5
VECTOR_MIN_SCORE=0.05
VECTOR_HYBRID_ALPHA=0.7
# 记忆条目达到该数量后，注入提示词前按与问题的相关性重排
SEMANTIC_RERANK_MIN_ENTRIES=6

# 工具调用 get_location 时，等待用户在页面授权浏览器定位的秒数；超时回退到 IP 定位
LOCATION_PERMISSION_TIMEOUT=90

# 文件访问模式：unrestricted 可访问本机任意路径；workspace 仅允许项目下 workspace/
FILE_ACCESS_MODE=unrestricted
# 相对路径的基准目录，默认项目根目录
# FILE_ROOT=E:\react_agent

# 写/编辑/移动/删除文件、批量补丁、运行测试、Git 写操作、执行命令前是否启用授权策略
REQUIRE_TOOL_APPROVAL=true
# 授权模式：
#   ask      = 每一步都询问
#   edits    = 自动接受项目内编辑和只读命令，其余询问
#   auto     = 项目内自动放行，项目外询问，危险命令直接拒绝（默认）
#   readonly = 拒绝所有写操作
TOOL_PERMISSION_MODE=auto
# 等待用户点击“允许/拒绝”的秒数
TOOL_PERMISSION_TIMEOUT=120

# 单次命令执行超时（秒，最大 600）与合并输出的最大展示字符数
COMMAND_TIMEOUT=120
COMMAND_MAX_OUTPUT_CHARS=12000

# 自进化 Harness：单代 diff 预算、测试/评测超时、Agent 最大工具轮数
EVOLUTION_MAX_DIFF_LINES=600
EVOLUTION_TEST_TIMEOUT=300
EVOLUTION_MAX_STEPS=40
